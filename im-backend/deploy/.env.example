# Copy to .env. Do not commit .env; use independent long random passwords.
IM_RELEASE_PORT=18080
IM_MYSQL_ROOT_PASSWORD=replace-with-unique-random-root-secret
IM_MYSQL_PASSWORD=replace-with-unique-random-app-secret
IM_PGVECTOR_PASSWORD=replace-with-unique-random-vector-secret

# For private loopback testing only: returns verification codes to the browser.
# Never enable when other users can reach the site; turn off after testing.
IM_LOCAL_TEST_CODES=false

# Optional until an SMTP account has been configured. Without it, registration,
# contact binding and password reset by email return 503. Phone SMS is not wired.
IM_SMTP_HOST=
IM_SMTP_PORT=587
IM_SMTP_USERNAME=
IM_SMTP_PASSWORD=
IM_SMTP_FROM=
